# Private runtime downloaded by install.py (includes third-party source)
.runtime/

# Local user preferences and editable personal presets
.forge_ai_prompt_settings.json
.forge_ai_prompt_settings.*
user_presets/

# Python, logs and editor artifacts
__pycache__/
*.py[cod]
*.log
.pytest_cache/
.mypy_cache/
.venv/
venv/
.vscode/
.idea/
*.tmp

# Never commit model weights or generated output
*.safetensors
*.ckpt
*.gguf
*.pth
*.pt
*.bin
outputs/

# Local experimental patch backups and temporary files
.fap_speed_v0217_backup/
.fap_dynamic_v0218_backup/
.fap_*.bak
*.fap_pending
*.fap_dynamic_pending
*.fap_console_pending
*.fap_quiet_startup_pending
